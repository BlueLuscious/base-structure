    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django(core): Run Server",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\core\\manage.py"
        },
        {
            "name": "Django(core): Create Superuser",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "createsuperuser"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\core\\manage.py"
        },
        {
            "name": "Django(core): Show Migrations",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "showmigrations"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\core\\manage.py"
        },
        {
            "name": "Django(core): Make Migrations",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "makemigrations"
            ],
            "django": true,
