{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "djangoTestTarget",
            "type": "promptString",
            "description": "Enter a Django test target such as app_name.tests or app_name.tests.TestCase.test_method",
            "default": "core.tests"
        }
    ],
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Django: Shell",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "shell"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Django: Test",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                "${input:djangoTestTarget}"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Django: Test All",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Celery: Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A",
                "core.celery",
                "worker",
                "--loglevel=info",
                "--pool=solo"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Celery: Beat",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A",
                "core.celery",
                "beat",
                "--loglevel=info"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}\\.env"
        }
    ]
}
